# =============================================================================
# Copie para `.env` e preencha:   cp .env.example .env
# O `.env` não vai para o Git — ele guarda segredos.
# =============================================================================

# --- Banco de dados (PostgreSQL) ---------------------------------------------
# Só é preciso preencher se você NÃO estiver usando o docker compose
# (no compose, o banco sobe junto e esta URL é montada automaticamente).
#
# Em hospedagem serverless (Vercel), acrescente &connection_limit=1 ao final:
# cada função abre a própria conexão, e sem o limite o banco esgota.
DATABASE_URL="postgresql://usuario:senha@host:5432/condominios?schema=public"

# --- Segurança ---------------------------------------------------------------
# Assina o cookie de sessão. Precisa ser aleatório e ter 40+ caracteres.
# Trocar este valor desconecta todo mundo (útil se vazar).
AUTH_SECRET="troque-por-um-texto-aleatorio-longo-e-secreto"

# --- Primeiro administrador (docker compose) ---------------------------------
# Preenchidos, o container cria o administrador no primeiro start.
# Depois de criado, pode apagar estas três linhas.
ADMIN_EMAIL="voce@suaempresa.com.br"
ADMIN_SENHA="umaSenhaForteDe10OuMais"
ADMIN_NOME="Seu Nome"

# Senha do PostgreSQL do compose e porta em que o sistema fica acessível.
POSTGRES_PASSWORD="troque-esta-senha-do-banco"
PORTA="3000"

# --- Alternativa sem as variáveis ADMIN_* ------------------------------------
# Habilita a tela /configuracao-inicial para criar o administrador pelo
# navegador. Remova depois de usar.
# SETUP_TOKEN="uma-senha-temporaria"

# --- Módulo de orçamentos ----------------------------------------------------
# Dados da sua empresa, impressos no cabeçalho do orçamento e do PDF.
# Sem eles o documento sai com "Sua Empresa" no lugar do seu nome.
EMPRESA_NOME="Sua Empresa Ltda"
EMPRESA_DOCUMENTO="00.000.000/0001-00"
EMPRESA_ENDERECO="Rua Exemplo, 123 — São Paulo/SP"
EMPRESA_TELEFONE="(11) 0000-0000"
EMPRESA_EMAIL="contato@suaempresa.com.br"

# Endereço público do sistema, usado para montar o link do orçamento que vai
# para o cliente. Na Vercel, o VERCEL_URL cobre as pré-visualizações sozinho;
# em produção, preencha aqui com o domínio definitivo.
APP_URL="https://seu-sistema.vercel.app"

# --- Envio dos orçamentos por e-mail (fase 3, ainda não implementada) --------
# A conta é Microsoft 365 corporativa, então o envio sai pela API Graph.
# Registre um aplicativo no Entra ID com permissão DE APLICAÇÃO Mail.Send e
# restrinja-o a uma única caixa com New-ApplicationAccessPolicy — sem essa
# restrição, a permissão vale para todas as caixas da empresa.
# EMAIL_PROVEDOR="graph"          # "graph" envia de verdade; "log" só registra
# EMAIL_REMETENTE="voce@suaempresa.com.br"
# EMAIL_NOME_REMETENTE="Sua Empresa"
# MS_TENANT_ID=""
# MS_CLIENT_ID=""
# MS_CLIENT_SECRET=""             # expira: anote a validade

# --- Apenas desenvolvimento --------------------------------------------------
SEED_PASSWORD="condominio123"
# MOSTRAR_CREDENCIAIS_DEMO="false"
