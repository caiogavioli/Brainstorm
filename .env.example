# Banco de dados
# SQLite (desenvolvimento):
DATABASE_URL="file:./dev.db"
# PostgreSQL (produção) — troque o provider em prisma/schema.prisma para "postgresql":
# DATABASE_URL="postgresql://usuario:senha@localhost:5432/condominios?schema=public"

# Segredo usado para assinar o cookie de sessão (JWT).
# Gere um valor próprio: openssl rand -base64 32
AUTH_SECRET="troque-este-valor-em-producao-com-openssl-rand-base64-32"

# Senha aplicada aos usuários criados pelo seed (apenas ambiente de demonstração).
SEED_PASSWORD="condominio123"
