# =============================================================================
# Copie para `.env` e preencha:   cp .env.example .env
# O `.env` não vai para o Git — ele guarda segredos.
# =============================================================================

# --- Banco de dados (PostgreSQL) ---------------------------------------------
# Só é preciso preencher se você NÃO estiver usando o docker compose
# (no compose, o banco sobe junto e esta URL é montada automaticamente).
DATABASE_URL="postgresql://usuario:senha@host:5432/condominios?schema=public"

# --- Segurança ---------------------------------------------------------------
# Assina o cookie de sessão. Precisa ser aleatório e ter 40+ caracteres.
# Trocar este valor desconecta todo mundo (útil se vazar).
AUTH_SECRET="troque-por-um-texto-aleatorio-longo-e-secreto"

# --- Primeiro administrador (docker compose) ---------------------------------
# Preenchidos, o container cria o administrador no primeiro start.
# Depois de criado, pode apagar estas três linhas.
ADMIN_EMAIL="voce@suaempresa.com.br"
ADMIN_SENHA="umaSenhaForteDe10OuMais"
ADMIN_NOME="Seu Nome"

# Senha do PostgreSQL do compose e porta em que o sistema fica acessível.
POSTGRES_PASSWORD="troque-esta-senha-do-banco"
PORTA="3000"

# --- Alternativa sem as variáveis ADMIN_* ------------------------------------
# Habilita a tela /configuracao-inicial para criar o administrador pelo
# navegador. Remova depois de usar.
# SETUP_TOKEN="uma-senha-temporaria"

# --- Apenas desenvolvimento --------------------------------------------------
SEED_PASSWORD="condominio123"
# MOSTRAR_CREDENCIAIS_DEMO="false"
