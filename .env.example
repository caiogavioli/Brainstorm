# =============================================================================
# Copie este arquivo para `.env` e preencha os valores.
#   cp .env.example .env
# O `.env` não vai para o Git — ele guarda segredos.
# =============================================================================

# --- Banco de dados (PostgreSQL) ---------------------------------------------
# Cole aqui a URL de conexão do seu provedor (Neon, Supabase, Vercel Postgres…).
# DATABASE_URL é usada pela aplicação; DIRECT_URL, pelas migrações.
# Se o seu provedor der apenas uma URL, repita a mesma nas duas.
DATABASE_URL="postgresql://usuario:senha@host/banco?sslmode=require"
DIRECT_URL="postgresql://usuario:senha@host/banco?sslmode=require"

# --- Segurança ---------------------------------------------------------------
# Assina o cookie de sessão. Gere um valor único e secreto:
#   openssl rand -base64 32
# Trocar este valor desconecta todo mundo (útil se vazar).
AUTH_SECRET="troque-este-valor-openssl-rand-base64-32"

# --- Fotos das ocorrências ---------------------------------------------------
# Só em produção (Vercel). Criado ao adicionar um Blob Store no painel da
# Vercel — ela mesma injeta esta variável. Sem ela, as fotos são gravadas em
# `public/uploads/`, o que funciona apenas em desenvolvimento local.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# --- Apenas desenvolvimento / demonstração -----------------------------------
# Senha aplicada aos usuários criados por `npm run db:seed`.
SEED_PASSWORD="condominio123"

# Exibe as credenciais de demonstração na tela de login. Em produção fica
# desligado automaticamente; só ative se o ambiente publicado for uma vitrine.
# MOSTRAR_CREDENCIAIS_DEMO="false"
