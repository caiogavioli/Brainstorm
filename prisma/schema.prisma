// Sistema de Gestão e Boletim Diário de Operações para Condomínios
//
// Banco relacional multi-condomínio (multi-tenant por `condominioId`).
//
// Provider: PostgreSQL, o mesmo em desenvolvimento e em produção.
//
// Uma única variável de conexão, de propósito: com poucos condomínios não há
// volume que justifique um pooler, e cada variável a mais é um passo a mais
// para errar na instalação. Use a URL direta do provedor.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

// Papéis de acesso. GESTOR = gerente predial (preenche o boletim).
// ADMIN = síndico profissional / gestor da administradora (vê tudo).
enum Papel {
  ADMIN
  GESTOR
}

enum StatusGeralDia {
  EM_CONFORMIDADE
  OCORRENCIA_PONTUAL
  OCORRENCIA_CRITICA
}

// Estado de cada item do checklist no boletim do dia.
enum SituacaoItem {
  CONFORME
  NAO_CONFORME
  NAO_APLICAVEL
}

enum Criticidade {
  BAIXA
  MEDIA
  ALTA
}

enum StatusOcorrencia {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDO
}

// ---------------------------------------------------------------------------
// Tabela 1: Condomínios (cadastro base)
// ---------------------------------------------------------------------------

model Condominio {
  id                 Int      @id @default(autoincrement())
  nome               String
  endereco           String?
  gerenteResponsavel String?
  telefone           String?
  email              String?
  ativo              Boolean  @default(true)
  criadoEm           DateTime @default(now())
  atualizadoEm       DateTime @updatedAt

  boletins    Boletim[]
  ocorrencias Ocorrencia[]
  planos      PlanoAcao[]
  acessos     UsuarioCondominio[]

  @@index([ativo])
}

// ---------------------------------------------------------------------------
// Usuários e escopo de acesso por condomínio
// ---------------------------------------------------------------------------

model Usuario {
  id           Int      @id @default(autoincrement())
  nome         String
  email        String   @unique
  senhaHash    String
  papel        Papel    @default(GESTOR)
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  acessos            UsuarioCondominio[]
  boletinsCriados    Boletim[]           @relation("BoletimCriadoPor")
  ocorrenciasAbertas Ocorrencia[]        @relation("OcorrenciaAbertaPor")
  logs               OcorrenciaLog[]
  orcamentosCriados  Orcamento[]         @relation("OrcamentoCriadoPor")
}

// Liga um usuário GESTOR aos condomínios que ele pode operar.
// ADMIN enxerga todos os condomínios independentemente desta tabela.
model UsuarioCondominio {
  usuarioId    Int
  condominioId Int

  usuario    Usuario    @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  condominio Condominio @relation(fields: [condominioId], references: [id], onDelete: Cascade)

  @@id([usuarioId, condominioId])
  @@index([condominioId])
}

// ---------------------------------------------------------------------------
// Catálogo de itens do checklist
//
// Os ~27 itens do boletim são linhas desta tabela (e não colunas booleanas).
// Isso permite: (a) incluir/desativar itens sem migração de schema,
// (b) cruzar "Ocorrências por Setor" direto com o item de origem,
// (c) manter histórico consistente mesmo quando o catálogo evolui.
// ---------------------------------------------------------------------------

model ChecklistItem {
  id         Int     @id @default(autoincrement())
  codigo     String  @unique // slug estável, ex.: "elevadores"
  nome       String
  // Código do grupo ("EQUIPES", "ELETRICA"…). Texto e não enum de propósito:
  // reorganizar o checklist é rotina de negócio, e um enum exigiria migração
  // de banco a cada ajuste.
  grupo      String
  grupoOrdem Int     @default(0)
  ordem      Int     @default(0)
  ativo      Boolean @default(true)

  // Gravidade intrínseca do assunto. É ela que define a criticidade e o prazo
  // da ocorrência — quem preenche o boletim relata o fato, não arbitra o peso.
  criticidadePadrao Criticidade @default(MEDIA)

  boletimItens BoletimItem[]
  ocorrencias  Ocorrencia[]

  @@index([grupo, ordem])
}

// ---------------------------------------------------------------------------
// Tabela 2: Boletim Diário
// ---------------------------------------------------------------------------

model Boletim {
  id             Int            @id @default(autoincrement())
  dataRegistro   DateTime       @default(now()) // data e hora do lançamento
  dataReferencia String // dia de referência "YYYY-MM-DD" (1 boletim por condomínio/dia)
  condominioId   Int
  statusGeral    StatusGeralDia @default(EM_CONFORMIDADE)

  // Derivados do checklist: um item do grupo EQUIPES marcado como não conforme
  // É o registro da falta. Não existe pergunta separada de faltas no formulário.
  houveFaltas   Boolean @default(false)
  setoresFaltas String? // equipes com desfalque, separadas por vírgula
  qtdeFaltas    Int     @default(0) // quantas equipes ficaram desfalcadas

  observacoes String?

  // Quem preencheu. O formulário é público (sem login), então o nome é digitado
  // por quem responde. `criadoPorId` só existe quando um usuário logado lança
  // pelo painel — os dois convivem.
  preenchidoPor String?
  criadoPorId   Int?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  condominio   Condominio              @relation(fields: [condominioId], references: [id], onDelete: Cascade)
  criadoPor    Usuario?                @relation("BoletimCriadoPor", fields: [criadoPorId], references: [id], onDelete: SetNull)
  itens        BoletimItem[]
  ocorrencias  Ocorrencia[]
  recorrencias OcorrenciaRecorrencia[]

  @@unique([condominioId, dataReferencia])
  @@index([condominioId, dataRegistro])
  @@index([dataReferencia])
}

// Resposta de um item do checklist dentro de um boletim.
model BoletimItem {
  id              Int          @id @default(autoincrement())
  boletimId       Int
  checklistItemId Int
  situacao        SituacaoItem @default(CONFORME)
  observacao      String?

  boletim       Boletim       @relation(fields: [boletimId], references: [id], onDelete: Cascade)
  checklistItem ChecklistItem @relation(fields: [checklistItemId], references: [id])
  ocorrencia    Ocorrencia? // ocorrência gerada automaticamente por este item

  @@unique([boletimId, checklistItemId])
  @@index([checklistItemId, situacao])
}

// ---------------------------------------------------------------------------
// Tabela 3: Ocorrências
// Criadas automaticamente a partir de itens NAO_CONFORME do boletim,
// ou lançadas avulsas pelo painel administrativo.
// ---------------------------------------------------------------------------

model Ocorrencia {
  id                  Int              @id @default(autoincrement())
  dataAbertura        DateTime         @default(now())
  condominioId        Int
  checklistItemId     Int? // setor/equipamento vindo do catálogo
  setorLivre          String? // setor digitado quando fora do catálogo
  descricao           String
  planoAcao           String?
  criticidade         Criticidade      @default(MEDIA)
  status              StatusOcorrencia @default(PENDENTE)
  previsaoFinalizacao DateTime? // SLA
  dataConclusao       DateTime?
  origem              String           @default("BOLETIM") // BOLETIM | AVULSA
  boletimId           Int?
  boletimItemId       Int?             @unique
  abertaPorId         Int?

  // Um problema que se arrasta continua sendo UMA ocorrência: cada boletim que
  // o reencontra vira uma linha em `recorrencias`, não uma ocorrência nova.
  ultimaRecorrenciaEm DateTime?
  totalRecorrencias   Int       @default(0)
  criadoEm            DateTime  @default(now())
  atualizadoEm        DateTime  @updatedAt

  condominio    Condominio              @relation(fields: [condominioId], references: [id], onDelete: Cascade)
  checklistItem ChecklistItem?          @relation(fields: [checklistItemId], references: [id])
  boletim       Boletim?                @relation(fields: [boletimId], references: [id], onDelete: SetNull)
  boletimItem   BoletimItem?            @relation(fields: [boletimItemId], references: [id], onDelete: SetNull)
  abertaPor     Usuario?                @relation("OcorrenciaAbertaPor", fields: [abertaPorId], references: [id], onDelete: SetNull)
  fotos         OcorrenciaFoto[]
  historico     OcorrenciaLog[]
  recorrencias  OcorrenciaRecorrencia[]

  @@index([condominioId, status])
  @@index([condominioId, dataAbertura])
  @@index([status, criticidade, previsaoFinalizacao])
}

// Registro de que um boletim reencontrou um problema que já estava aberto.
// A unicidade por (ocorrência, boletim) torna o reenvio do mesmo dia idempotente.
model OcorrenciaRecorrencia {
  id             Int      @id @default(autoincrement())
  ocorrenciaId   Int
  boletimId      Int
  dataReferencia String // dia do boletim que reencontrou o problema
  observacao     String?
  criadoEm       DateTime @default(now())

  ocorrencia Ocorrencia @relation(fields: [ocorrenciaId], references: [id], onDelete: Cascade)
  boletim    Boletim    @relation(fields: [boletimId], references: [id], onDelete: Cascade)

  @@unique([ocorrenciaId, boletimId])
  @@index([boletimId])
}

model OcorrenciaFoto {
  id           Int      @id @default(autoincrement())
  ocorrenciaId Int
  caminho      String // URL pública, ex.: /uploads/ocorrencias/xxx.jpg
  nomeOriginal String?
  mime         String?
  tamanho      Int?
  criadoEm     DateTime @default(now())

  ocorrencia Ocorrencia @relation(fields: [ocorrenciaId], references: [id], onDelete: Cascade)

  @@index([ocorrenciaId])
}

// Log de atualizações (campo "Observações/Histórico").
model OcorrenciaLog {
  id           Int      @id @default(autoincrement())
  ocorrenciaId Int
  usuarioId    Int?
  mensagem     String
  campo        String?
  valorAntes   String?
  valorDepois  String?
  criadoEm     DateTime @default(now())

  ocorrencia Ocorrencia @relation(fields: [ocorrenciaId], references: [id], onDelete: Cascade)
  usuario    Usuario?   @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([ocorrenciaId, criadoEm])
}

// ---------------------------------------------------------------------------
// Tabela 4: Plano de Ação (projetos de longo prazo e visitas operacionais)
// ---------------------------------------------------------------------------

model PlanoAcao {
  id                  Int              @id @default(autoincrement())
  dataCriacao         DateTime         @default(now())
  condominioId        Int
  local               String
  descricao           String
  criticidade         Criticidade      @default(MEDIA)
  status              StatusOcorrencia @default(PENDENTE)
  previsaoFinalizacao DateTime?
  dataConclusao       DateTime?
  responsavel         String?
  observacoes         String?
  criadoEm            DateTime         @default(now())
  atualizadoEm        DateTime         @updatedAt

  condominio Condominio @relation(fields: [condominioId], references: [id], onDelete: Cascade)

  @@index([condominioId, status])
  @@index([status, previsaoFinalizacao])
}

// ===========================================================================
// Módulo de Orçamentos — fase 1: cadastros
//
// Área comercial do sistema, independente do módulo de condomínios: o cliente
// que recebe um orçamento pode não ser (ainda) um prédio administrado.
//
// O desenho completo do módulo está em PLANO-ORCAMENTOS.md. Esta fase entrega
// só as bases que o orçamento vai consumir: para quem se orça (`Cliente`), o
// que se orça (`ServicoCatalogo`) e o orçamento padrão pronto
// (`ModeloOrcamento`).
// ===========================================================================

// ---------------------------------------------------------------------------
// Cliente — quem recebe o orçamento
// ---------------------------------------------------------------------------

model Cliente {
  id   Int    @id @default(autoincrement())
  nome String // razão social ou nome da pessoa

  // Quem lê e assina, quando o cliente é uma empresa. Guardado separado do
  // `nome` porque é ele que abre o e-mail: "Prezado João" tem outra taxa de
  // resposta que "Prezada Construtora Andrade Ltda".
  contato String?

  // Sempre em minúsculas — ver `normalizarEmail` em src/lib/acoes/clientes.ts.
  // Único: dois cadastros com o mesmo e-mail viram dois históricos parciais do
  // mesmo cliente, e nenhum dos dois conta a verdade.
  email String @unique

  telefone    String?
  documento   String? // CNPJ ou CPF
  endereco    String?
  observacoes String?

  // Desativar tira o cliente da lista de seleção sem apagar o histórico
  // comercial. Mesmo princípio de `Condominio.ativo`.
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  orcamentos Orcamento[]

  @@index([ativo, nome])
}

// ---------------------------------------------------------------------------
// Catálogo de serviços — a base da padronização
//
// Mesma escolha do `ChecklistItem`: o catálogo é DADO, não código. Serviços
// entram, mudam de preço e são aposentados pela tela, sem migração de banco.
//
// O item do orçamento vai COPIAR daqui descrição, unidade e valor no momento em
// que for criado, guardando só a referência de origem. Reajustar um preço
// amanhã não pode reescrever o valor de um orçamento que o cliente já recebeu.
// ---------------------------------------------------------------------------

model ServicoCatalogo {
  id     Int    @id @default(autoincrement())
  codigo String @unique // slug estável derivado do nome, ex.: "limpeza-de-caixa-dagua"
  nome   String

  descricao String?

  // Texto e não enum, pelo mesmo motivo de `ChecklistItem.grupo`: reorganizar a
  // lista de serviços é rotina de negócio, e um enum exigiria migração de banco
  // a cada categoria nova.
  categoria String @default("Geral")

  // "un", "h", "m²", "visita", "mês"… Livre pelo mesmo motivo da categoria.
  unidade String @default("un")

  // Em centavos inteiros. Dinheiro em ponto flutuante erra: 0,1 + 0,2 não dá
  // 0,3 em nenhuma linguagem que use float, e num orçamento de dezenas de
  // linhas o total fecha com centavos de diferença da soma na calculadora —
  // que é exatamente o tipo de erro que o cliente nota.
  valorPadraoCentavos Int @default(0)

  ativo        Boolean  @default(true)
  ordem        Int      @default(0)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  itensModelo    ModeloOrcamentoItem[]
  itensOrcamento OrcamentoItem[]

  @@index([ativo, categoria, ordem])
}

// ---------------------------------------------------------------------------
// Modelo de orçamento — o orçamento padrão pronto
//
// É isto que torna o orçamento "padronizado" na prática: um conjunto de itens
// mais os textos que se repetem. Sem modelo, padrão é só uma intenção — cada
// orçamento sai um pouco diferente do anterior.
// ---------------------------------------------------------------------------

model ModeloOrcamento {
  id        Int     @id @default(autoincrement())
  nome      String
  descricao String? // para que serve este modelo, visível só internamente

  // Textos que entram prontos no orçamento e quase nunca mudam.
  condicoesPagamento String?
  prazoExecucao      String?
  observacoes        String?

  // Quantos dias o orçamento vale, contados do envio. Vira `validoAte`.
  validadeDias Int @default(15)

  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  itens ModeloOrcamentoItem[]

  @@index([ativo, nome])
}

model ModeloOrcamentoItem {
  id       Int @id @default(autoincrement())
  modeloId Int

  // De qual serviço do catálogo esta linha nasceu. Opcional: o modelo aceita
  // linha avulsa. `SetNull` para que aposentar um serviço não apague o modelo.
  servicoCatalogoId Int?

  ordem     Int     @default(0)
  descricao String
  detalhe   String?
  unidade   String  @default("un")

  // Quantidade em milésimos (1500 = 1,5), pelo mesmo motivo dos centavos:
  // inteiro fecha a conta, decimal binário não. Permite meia hora, 2,5 m².
  quantidadeMilesimos Int @default(1000)

  valorUnitarioCentavos Int @default(0)

  modelo  ModeloOrcamento  @relation(fields: [modeloId], references: [id], onDelete: Cascade)
  servico ServicoCatalogo? @relation(fields: [servicoCatalogoId], references: [id], onDelete: SetNull)

  @@index([modeloId, ordem])
  @@index([servicoCatalogoId])
}

// ===========================================================================
// Módulo de Orçamentos — fase 2: o orçamento
// ===========================================================================

/// Ciclo de vida do orçamento.
///
/// RASCUNHO -> ENVIADO -> VISUALIZADO -> ACEITO
///                                    -> RECUSADO
///                                    -> AJUSTE_SOLICITADO -> (nova versão)
///                                    -> EXPIRADO
///
/// AJUSTE_SOLICITADO é o estado que responde "preciso entregar mais alguma
/// coisa?". Não é fim de linha: gera uma versão nova, que recomeça o fluxo.
enum StatusOrcamento {
  RASCUNHO
  ENVIADO
  VISUALIZADO
  ACEITO
  RECUSADO
  AJUSTE_SOLICITADO
  EXPIRADO
}

model Orcamento {
  id Int @id @default(autoincrement())

  /// Sequencial por ano, visível ao cliente: "2026-0007". É por ele que o
  /// cliente se refere ao documento no telefone, então precisa ser curto,
  /// previsível e nunca repetir. A geração está em src/lib/orcamentos/numero.ts.
  numero String @unique

  clienteId Int
  titulo    String
  status    StatusOrcamento @default(RASCUNHO)

  /// Quantas vezes este orçamento foi refeito depois de um pedido de ajuste.
  /// Aparece como "v2" ao lado do número.
  versao Int @default(1)

  /// Totais em centavos, gravados no momento em que o orçamento é salvo.
  ///
  /// Redundantes em relação aos itens, e de propósito: é este o valor que foi
  /// mostrado ao cliente. Recalcular na leitura faria um orçamento antigo mudar
  /// de total se a regra de arredondamento mudasse um dia.
  subtotalCentavos Int @default(0)
  descontoCentavos Int @default(0)
  totalCentavos    Int @default(0)

  condicoesPagamento String?
  prazoExecucao      String?
  observacoes        String?

  /// Até quando o orçamento vale. Passou disso sem resposta, vira EXPIRADO.
  validoAte DateTime?

  /// Endereço secreto do link público (32 bytes aleatórios em base64url).
  ///
  /// É a única credencial da página do cliente, então precisa ser impossível de
  /// adivinhar por tentativa. Nasce junto com o orçamento — criar a coluna
  /// depois, já com linhas na tabela, exigiria preencher o passado com valores
  /// inventados.
  token String @unique

  /// Rastreio. `enviadoEm` é o nosso registro de disparo; as visualizações são
  /// contadas por acesso ao link, não por pixel de abertura — ver o porquê em
  /// PLANO-ORCAMENTOS.md, seção 1.
  enviadoEm              DateTime?
  primeiraVisualizacaoEm DateTime?
  ultimaVisualizacaoEm   DateTime?
  totalVisualizacoes     Int       @default(0)
  respondidoEm           DateTime?
  respostaMensagem       String?

  criadoPorId  Int?
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  cliente   Cliente         @relation(fields: [clienteId], references: [id])
  criadoPor Usuario?        @relation("OrcamentoCriadoPor", fields: [criadoPorId], references: [id], onDelete: SetNull)
  itens     OrcamentoItem[]

  @@index([status, criadoEm])
  @@index([clienteId, criadoEm])
  @@index([status, validoAte])
}

model OrcamentoItem {
  id          Int @id @default(autoincrement())
  orcamentoId Int

  /// De qual serviço do catálogo esta linha nasceu. É o que permite responder
  /// depois "quanto já orcei de manutenção elétrica este ano". `SetNull` porque
  /// aposentar um serviço não pode apagar um orçamento emitido.
  servicoCatalogoId Int?

  ordem     Int     @default(0)
  descricao String
  detalhe   String?
  unidade   String  @default("un")

  quantidadeMilesimos   Int @default(1000)
  valorUnitarioCentavos Int @default(0)

  /// Total da linha, gravado. Mesmo motivo dos totais do orçamento: é o número
  /// que o cliente viu, e ele não pode mudar depois.
  totalCentavos Int @default(0)

  orcamento Orcamento        @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)
  servico   ServicoCatalogo? @relation(fields: [servicoCatalogoId], references: [id], onDelete: SetNull)

  @@index([orcamentoId, ordem])
  @@index([servicoCatalogoId])
}
